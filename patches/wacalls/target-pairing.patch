+++ b/cmd/server/targetpairing_test.go
@@ -0,0 +1,215 @@
+package main
+
+import (
+	"context"
+	"github.com/google/uuid"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waWeb"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func pairingMessage(phone, code string) *events.Message {
+	jid := types.NewJID(phone, types.DefaultUserServer)
+	return &events.Message{Info: types.MessageInfo{MessageSource: types.MessageSource{Sender: jid, Chat: jid}, Timestamp: time.Now()}, Message: &waE2E.Message{Conversation: proto.String(code)}}
+}
+func armTestTarget(s *Session, method string) {
+	s.target = &targetPairing{ID: uuid.NewString(), Method: method, State: "waiting", ExpiresAt: time.Now().Add(time.Minute), armedAt: time.Now().Add(-time.Second), code: "VOX-012345ABCDEF"}
+}
+func TestTargetMessageFiltering(t *testing.T) {
+	for name, modify := range map[string]func(*events.Message){
+		"history": func(e *events.Message) { e.SourceWebMsg = &waWeb.WebMessageInfo{} },
+		"self":    func(e *events.Message) { e.Info.IsFromMe = true }, "group": func(e *events.Message) { e.Info.IsGroup = true }, "broadcast": func(e *events.Message) { e.Info.Chat = types.NewJID("status", types.BroadcastServer) }, "edit": func(e *events.Message) { e.IsEdit = true }, "bot": func(e *events.Message) { e.IsBotInvoke = true }, "retry": func(e *events.Message) { e.RetryCount = 1 }, "sync": func(e *events.Message) { e.UnavailableRequestID = "id" }, "wrapper": func(e *events.Message) { e.IsEphemeral = true }, "payload": func(e *events.Message) { e.Message.ImageMessage = &waE2E.ImageMessage{} }, "text": func(e *events.Message) { e.Message.Conversation = proto.String("ordinary private text") }, "stale": func(e *events.Message) { e.Info.Timestamp = time.Now().Add(-time.Hour) }, "lid": func(e *events.Message) {
+			e.Info.Sender = types.NewJID("1234567890", types.HiddenUserServer)
+			e.Info.Chat = e.Info.Sender
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			mgr := newTestManager(t)
+			s := mgr.addUnconnected(t, "test")
+			armTestTarget(s, "message")
+			e := pairingMessage("1234567890", s.target.code)
+			modify(e)
+			s.observeTargetMessage(e)
+			if s.target.State != "waiting" {
+				t.Fatal("ineligible event accepted")
+			}
+		})
+	}
+}
+func TestTargetFirstCandidateAndCancellation(t *testing.T) {
+	mgr := newTestManager(t)
+	s := mgr.addUnconnected(t, "test")
+	armTestTarget(s, "message")
+	s.observeTargetMessage(pairingMessage("1234567890", s.target.code))
+	if s.target.Candidate == nil || s.target.Candidate.Phone != "+1234567890" {
+		t.Fatal("missing canonical candidate")
+	}
+	id := s.target.Candidate.ID
+	s.observeTargetMessage(pairingMessage("1234567891", "VOX-012345ABCDEF"))
+	if s.target.Candidate.ID != id {
+		t.Fatal("overwritten")
+	}
+	s.cancelTarget()
+	s.observeTargetMessage(pairingMessage("1234567891", "VOX-012345ABCDEF"))
+	if s.target.Candidate != nil || s.target.code != "" {
+		t.Fatal("cancel retained secret or candidate")
+	}
+}
+func TestTargetExpiryAndOwnAccount(t *testing.T) {
+	mgr := newTestManager(t)
+	s := mgr.addUnconnected(t, "test")
+	jid := types.NewJID("1234567890", types.DefaultUserServer)
+	s.client.Store.ID = &jid
+	armTestTarget(s, "message")
+	s.observeTargetMessage(pairingMessage(jid.User, s.target.code))
+	if s.target.Candidate != nil {
+		t.Fatal("own account accepted")
+	}
+	s.target.ExpiresAt = time.Now().Add(-time.Second)
+	s.observeTargetMessage(pairingMessage("1234567891", s.target.code))
+	if s.target.State != "expired" || s.target.code != "" {
+		t.Fatal("expiry not enforced")
+	}
+	if targetPhone(context.Background(), types.NewJID("1234567890", types.HiddenUserServer), nil) != "" {
+		t.Fatal("LID treated as phone")
+	}
+}
+func TestTargetConcurrentCancel(t *testing.T) {
+	mgr := newTestManager(t)
+	s := mgr.addUnconnected(t, "test")
+	armTestTarget(s, "message")
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			s.observeTargetMessage(pairingMessage("1234567890", "VOX-012345ABCDEF"))
+			s.cancelTarget()
+		}()
+	}
+	wg.Wait()
+	if s.target.State != "cancelled" || s.target.Candidate != nil {
+		t.Fatal("late candidate survived")
+	}
+}
+func TestTargetHTTPValidationAndUnknownID(t *testing.T) {
+	srv := &server{sessions: newTestManager(t)}
+	for _, body := range []string{`{}`, `{"extra":true}`, strings.Repeat("x", 1025), `{"id":"nope","method":"call"}`} {
+		r := httptest.NewRequest("POST", "/", strings.NewReader(body))
+		w := httptest.NewRecorder()
+		srv.handleTargetPairingStart(w, r)
+		if w.Code != 400 {
+			t.Fatalf("status %d", w.Code)
+		}
+	}
+	s := srv.sessions.addUnconnected(t, "test")
+	armTestTarget(s, "message")
+	r := httptest.NewRequest("GET", "/", nil)
+	r.SetPathValue("sid", s.id)
+	r.SetPathValue("id", uuid.NewString())
+	w := httptest.NewRecorder()
+	srv.handleTargetPairingGet(w, r)
+	if w.Code != 404 {
+		t.Fatal("unknown id accepted")
+	}
+	r.SetPathValue("id", s.target.ID)
+	w = httptest.NewRecorder()
+	srv.handleTargetPairingGet(w, r)
+	if strings.Contains(w.Body.String(), "VOX-") {
+		t.Fatal("code leaked")
+	}
+	w = httptest.NewRecorder()
+	srv.handleTargetPairingCancel(w, r)
+	if s.target.State != "cancelled" {
+		t.Fatal("cancellation incomplete")
+	}
+}
+func TestTargetCallConsumesBeforeLedgerAndFreezes(t *testing.T) {
+	mgr := newTestManager(t)
+	s := mgr.addUnconnected(t, "test")
+	armTestTarget(s, "call")
+	offer := &events.CallOffer{BasicCallMeta: types.BasicCallMeta{From: types.NewJID("1234567890", types.DefaultUserServer), Timestamp: time.Now()}}
+	s.onIncomingOffer(context.Background(), offer)
+	if s.target.Candidate == nil || !canonicalUUID(s.target.Candidate.ID) || s.reg.count() != 0 {
+		t.Fatal("call did not produce isolated UUID candidate")
+	}
+	id := s.target.Candidate.ID
+	offer.From = types.NewJID("1234567891", types.DefaultUserServer)
+	s.onIncomingOffer(context.Background(), offer)
+	if s.target.Candidate.ID != id || s.reg.count() != 0 {
+		t.Fatal("pending candidate overwritten or call created")
+	}
+	s.shutdown()
+	if s.target.State != "cancelled" {
+		t.Fatal("shutdown left observer")
+	}
+}
+func TestTargetTextTransportMetadata(t *testing.T) {
+	code := "VOX-012345ABCDEF"
+	metadata := &waE2E.MessageContextInfo{DeviceListMetadata: &waE2E.DeviceListMetadata{SenderTimestamp: proto.Uint64(123)}, DeviceListMetadataVersion: proto.Int32(2), MessageSecret: []byte{1, 2, 3}, ReportingTokenVersion: proto.Int32(1)}
+	for _, extended := range []bool{false, true} {
+		e := pairingMessage("1234567890", code)
+		e.Message.MessageContextInfo = metadata
+		if extended {
+			e.Message.Conversation = nil
+			e.Message.ExtendedTextMessage = &waE2E.ExtendedTextMessage{Text: proto.String(code), ContextInfo: &waE2E.ContextInfo{Expiration: proto.Uint32(0), EphemeralSettingTimestamp: proto.Int64(123)}}
+		}
+		e.RawMessage = proto.Clone(e.Message).(*waE2E.Message)
+		if plainTargetText(e) != code {
+			t.Fatal("ordinary text transport metadata rejected")
+		}
+	}
+	for name, modify := range map[string]func(*waE2E.Message){
+		"quote": func(m *waE2E.Message) {
+			m.ExtendedTextMessage.ContextInfo = &waE2E.ContextInfo{QuotedMessage: &waE2E.Message{Conversation: proto.String(code)}}
+		},
+		"forward": func(m *waE2E.Message) {
+			m.ExtendedTextMessage.ContextInfo = &waE2E.ContextInfo{IsForwarded: proto.Bool(true)}
+		},
+		"forward score": func(m *waE2E.Message) {
+			m.ExtendedTextMessage.ContextInfo = &waE2E.ContextInfo{ForwardingScore: proto.Uint32(1)}
+		},
+		"bot":     func(m *waE2E.Message) { m.MessageContextInfo = &waE2E.MessageContextInfo{BotMessageSecret: []byte{1}} },
+		"mixed":   func(m *waE2E.Message) { m.Conversation = proto.String(code) },
+		"preview": func(m *waE2E.Message) { m.ExtendedTextMessage.Title = proto.String("title") },
+		"unknown": func(m *waE2E.Message) { m.ExtendedTextMessage.ProtoReflect().SetUnknown([]byte{0xf8, 0x07, 0x01}) },
+	} {
+		t.Run(name, func(t *testing.T) {
+			e := pairingMessage("1234567890", code)
+			e.Message = &waE2E.Message{ExtendedTextMessage: &waE2E.ExtendedTextMessage{Text: proto.String(code)}}
+			modify(e.Message)
+			if plainTargetText(e) != "" {
+				t.Fatal("nonordinary payload accepted")
+			}
+		})
+	}
+}
+func TestTargetProviderTimestampPrecision(t *testing.T) {
+	for _, method := range []string{"message", "call"} {
+		for _, secondsAgo := range []int{0, 1} {
+			mgr := newTestManager(t)
+			s := mgr.addUnconnected(t, "test")
+			armTestTarget(s, method)
+			// Whatsmeow decodes both event timestamps from seconds with UnixTime("t").
+			s.target.armedAt = time.Now().Truncate(time.Second).Add(500 * time.Millisecond)
+			timestamp := s.target.armedAt.Truncate(time.Second).Add(-time.Duration(secondsAgo) * time.Second)
+			if method == "message" {
+				e := pairingMessage("1234567890", s.target.code)
+				e.Info.Timestamp = timestamp
+				s.observeTargetMessage(e)
+			} else {
+				s.onIncomingOffer(context.Background(), &events.CallOffer{BasicCallMeta: types.BasicCallMeta{From: types.NewJID("1234567890", types.DefaultUserServer), Timestamp: timestamp}})
+			}
+			if (s.target.Candidate != nil) != (secondsAgo == 0) {
+				t.Fatalf("%s: incorrect precision boundary", method)
+			}
+		}
+	}
+}
