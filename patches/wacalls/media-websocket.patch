+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+type phoneLookupFunc func(context.Context, types.JID) (types.JID, error)
+
+func (f phoneLookupFunc) GetPNForLID(ctx context.Context, jid types.JID) (types.JID, error) {
+	return f(ctx, jid)
+}
+
+func TestStoredPeerPhoneUsesOnlyBoundedAuthoritativeMapping(t *testing.T) {
+	called := false
+	lookup := phoneLookupFunc(func(ctx context.Context, jid types.JID) (types.JID, error) {
+		called = true
+		deadline, ok := ctx.Deadline()
+		if !ok || time.Until(deadline) > time.Second {
+			t.Fatal("lookup has no short deadline")
+		}
+		if jid.Server != types.HiddenUserServer || jid.User != "987654321" || jid.Device != 0 {
+			t.Fatal("LID mapping key changed")
+		}
+		return types.NewJID("15551234567", types.DefaultUserServer), nil
+	})
+	if got := storedPeerPhone(context.Background(), "987654321:2@lid", lookup); got != "15551234567@s.whatsapp.net" || !called {
+		t.Fatalf("mapping missing: %q", got)
+	}
+	called = false
+	if got := storedPeerPhone(context.Background(), "15551234567@s.whatsapp.net", lookup); got != "" || called {
+		t.Fatal("non-LID triggered lookup")
+	}
+}
+func TestStoredPeerPhoneMissingInvalidAndCanceledFailClosed(t *testing.T) {
+	for _, pn := range []types.JID{{}, types.NewJID("987654321", types.HiddenUserServer), types.NewJID("not-phone", types.DefaultUserServer)} {
+		lookup := phoneLookupFunc(func(context.Context, types.JID) (types.JID, error) { return pn, nil })
+		if got := storedPeerPhone(context.Background(), "987654321@lid", lookup); got != "" {
+			t.Fatal("invalid mapping accepted")
+		}
+	}
+	lookup := phoneLookupFunc(func(context.Context, types.JID) (types.JID, error) {
+		return types.JID{}, errors.New("private database details")
+	})
+	if got := storedPeerPhone(context.Background(), "987654321@lid", lookup); got != "" {
+		t.Fatal("lookup error accepted")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if got := storedPeerPhone(ctx, "987654321@lid", phoneLookupFunc(func(context.Context, types.JID) (types.JID, error) {
+		t.Fatal("canceled lookup executed")
+		return types.JID{}, nil
+	})); got != "" {
+		t.Fatal("canceled mapping accepted")
+	}
+}
+func TestIncomingEventOmitsUnresolvedPhoneIdentity(t *testing.T) {
+	b := NewBroker()
+	sub := b.subscribe("operator")
+	defer b.unsubscribe(sub)
+	for _, phone := range []string{"", "15551234567@s.whatsapp.net"} {
+		b.emitIncoming("session", "call", "987654321@lid", phone)
+		var event map[string]any
+		if err := json.Unmarshal(<-sub.ch, &event); err != nil {
+			t.Fatal(err)
+		}
+		value, present := event["peer_phone_jid"]
+		if (phone == "" && present) || (phone != "" && value != phone) {
+			t.Fatal("incorrect mapped identity field")
+		}
+		if event["peer"] != "987654321@lid" {
+			t.Fatal("original identity overwritten")
+		}
+	}
+}
