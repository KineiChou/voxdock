new file mode 100644
index 0000000..a49d5c7
--- /dev/null
+++ b/cmd/server/accountunlink.go
@@ -0,0 +1,200 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/store"
+)
+
+var errUnlinkBusy = errors.New("session has active calls or pairing")
+var errUnlinkRecovery = errors.New("account unlink unconfirmed")
+
+func (m *SessionManager) unlinkState(ctx context.Context, id string) (bool, bool, error) {
+	var confirmed bool
+	err := m.store.db.QueryRowContext(ctx, `SELECT remote_confirmed FROM account_unlinks WHERE session_id = ?`, id).Scan(&confirmed)
+	if errors.Is(err, sql.ErrNoRows) {
+		return false, false, nil
+	}
+	return err == nil, confirmed, err
+}
+
+// Logout calls Device.Delete only after the server acknowledges remove-companion-device.
+// Persist that boundary before deleting local keys so cleanup can resume after restart.
+type unlinkDeviceContainer struct {
+	store.DeviceContainer
+	manager   *SessionManager
+	sessionID string
+}
+
+func (c *unlinkDeviceContainer) DeleteDevice(ctx context.Context, device *store.Device) error {
+	_, err := c.manager.store.db.ExecContext(ctx, `UPDATE account_unlinks SET remote_confirmed = 1 WHERE session_id = ?`, c.sessionID)
+	if err != nil {
+		return err
+	}
+	return c.DeviceContainer.DeleteDevice(ctx, device)
+}
+
+func (s *server) handleConnectionUnlink(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	body, err := io.ReadAll(io.LimitReader(r.Body, 1025))
+	id := r.PathValue("sid")
+	var object map[string]json.RawMessage
+	if err != nil || len(body) > 1024 || !connectionID.MatchString(id) || json.Unmarshal(body, &object) != nil || object == nil || len(object) != 0 {
+		writeJSON(w, 400, map[string]string{"error": "expected empty object and valid session"})
+		return
+	}
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	ctx, cancel := context.WithTimeout(r.Context(), 8*time.Second)
+	defer cancel()
+	sess, err := s.sessions.unlinkAccount(ctx, id)
+	if err != nil {
+		code := http.StatusBadGateway
+		state := "unlink_recovery_required"
+		if errors.Is(err, errUnlinkBusy) {
+			code = http.StatusConflict
+			state = "busy"
+		}
+		writeJSON(w, code, map[string]string{"error": err.Error(), "state": state})
+		return
+	}
+	s.connectionStatus(w, sess)
+}
+
+func (m *SessionManager) unlinkAccount(ctx context.Context, id string) (*Session, error) {
+	ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+	defer cancel()
+	return m.unlinkAccountUsing(ctx, id, func(ctx context.Context, client *whatsmeow.Client) error {
+		if !client.IsConnected() {
+			if err := client.ConnectContext(ctx); err != nil {
+				return err
+			}
+		}
+		ticker := time.NewTicker(50 * time.Millisecond)
+		defer ticker.Stop()
+		for !client.IsLoggedIn() {
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-ticker.C:
+			}
+		}
+		return client.Logout(ctx)
+	})
+}
+
+// Called under connectionMu. The injected operation is the real pinned Logout in production.
+func (m *SessionManager) unlinkAccountUsing(ctx context.Context, id string, logout func(context.Context, *whatsmeow.Client) error) (*Session, error) {
+	sess, exists := m.Get(id)
+	if !exists {
+		pending, _, err := m.unlinkState(ctx, id)
+		if err != nil || pending {
+			return nil, errUnlinkRecovery
+		}
+		return nil, nil
+	}
+	sess.mu.Lock()
+	sess.expireTargetLocked(time.Now())
+	if (sess.pairingDone != nil && !sess.pairingCompleted) || sess.reg.count() != 0 || (sess.target != nil && (sess.target.State == "waiting" || sess.target.State == "candidate")) {
+		sess.mu.Unlock()
+		return nil, errUnlinkBusy
+	}
+	sess.unlinking = true // Reserve before releasing the same lock used to admit calls.
+	if sess.pairingCancel != nil {
+		sess.pairingCancel()
+		sess.pairingCancel = nil
+	}
+	done := sess.pairingDone
+	sess.mu.Unlock()
+	if done != nil {
+		select {
+		case <-done:
+		case <-ctx.Done():
+			sess.setAuth(AuthSnapshot{State: "unlink_recovery_required", Paired: sess.client.Store.ID != nil})
+			return nil, errUnlinkRecovery
+		}
+	}
+	// RemoveEventHandlers takes the dispatch write lock, joining in-flight callbacks.
+	sess.client.RemoveEventHandlers()
+	sess.cancelTarget()
+	sess.setAuth(AuthSnapshot{State: "unlink_recovery_required", Paired: sess.client.Store.ID != nil})
+	pending, confirmed, err := m.unlinkState(ctx, id)
+	if err != nil {
+		return nil, errUnlinkRecovery
+	}
+	if !pending {
+		confirmed = sess.client.Store.ID == nil
+		tx, err := m.store.db.BeginTx(ctx, nil)
+		if err != nil {
+			return nil, errUnlinkRecovery
+		}
+		jid := ""
+		if sess.client.Store.ID != nil {
+			jid = sess.client.Store.ID.String()
+		}
+		if _, err = tx.ExecContext(ctx, `UPDATE sessions SET jid = ? WHERE id = ?`, jid, id); err == nil {
+			_, err = tx.ExecContext(ctx, `INSERT INTO account_unlinks(session_id, remote_confirmed) VALUES (?, ?)`, id, confirmed)
+		}
+		if err != nil {
+			tx.Rollback()
+			return nil, errUnlinkRecovery
+		}
+		if err = tx.Commit(); err != nil {
+			return nil, errUnlinkRecovery
+		}
+	}
+	if !confirmed {
+		if sess.client.Store.ID == nil {
+			return nil, errUnlinkRecovery
+		}
+		device := sess.client.Store
+		original := device.Container
+		device.Container = &unlinkDeviceContainer{DeviceContainer: original, manager: m, sessionID: id}
+		err = logout(ctx, sess.client)
+		device.Container = original
+		sess.client.Disconnect()
+		if err != nil {
+			return nil, errUnlinkRecovery
+		}
+		_, confirmed, err = m.unlinkState(ctx, id)
+		if err != nil || !confirmed {
+			return nil, errUnlinkRecovery
+		}
+	}
+	sess.client.Disconnect()
+	if sess.client.Store.ID != nil {
+		if err := sess.client.Store.Delete(ctx); err != nil {
+			return nil, errUnlinkRecovery
+		}
+	}
+	// Clear the application JID and recovery marker atomically; never delete call history.
+	tx, err := m.store.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, errUnlinkRecovery
+	}
+	defer tx.Rollback()
+	if _, err = tx.ExecContext(ctx, `UPDATE sessions SET jid = NULL WHERE id = ?`, id); err != nil {
+		return nil, errUnlinkRecovery
+	}
+	if _, err = tx.ExecContext(ctx, `DELETE FROM account_unlinks WHERE session_id = ?`, id); err != nil {
+		return nil, errUnlinkRecovery
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, errUnlinkRecovery
+	}
+	fresh := newSession(m, id, sess.name, whatsmeow.NewClient(m.container.NewDevice(), m.waLogger))
+	fresh.auth = AuthSnapshot{State: "unlinked", Paired: false}
+	m.mu.Lock()
+	m.sessions[id] = fresh
+	m.mu.Unlock()
+	m.broker.emitAuthState(id, fresh.auth)
+	m.broker.emitSessionList(m.infos())
+	return fresh, nil
+}
diff --git a/cmd/server/accountunlink_test.go b/cmd/server/accountunlink_test.go
new file mode 100644
index 0000000..47dcca5
--- /dev/null
+++ b/cmd/server/accountunlink_test.go
@@ -0,0 +1,273 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waAdv"
+	"go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func unlinkRequest(m *SessionManager, id, body string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest("POST", "/", strings.NewReader(body))
+	req.SetPathValue("sid", id)
+	out := httptest.NewRecorder()
+	(&server{sessions: m}).handleConnectionUnlink(out, req)
+	return out
+}
+func TestAccountUnlinkStrictAndRepeat(t *testing.T) {
+	m := newTestManager(t)
+	for _, body := range []string{"", "null", "[]", `{"unexpected":true}`, "{}{}"} {
+		if got := unlinkRequest(m, "missing", body).Code; got != 400 {
+			t.Fatalf("body %q: %d", body, got)
+		}
+	}
+	if unlinkRequest(m, "../bad", "{}").Code != 400 {
+		t.Fatal("invalid ID accepted")
+	}
+	if out := unlinkRequest(m, "missing", "{}"); out.Code != 200 || !strings.Contains(out.Body.String(), `"state":"missing"`) {
+		t.Fatal(out)
+	}
+	sess := m.addUnconnected(t, "test")
+	for range 2 {
+		out := unlinkRequest(m, sess.id, "{}")
+		if out.Code != 200 || !strings.Contains(out.Body.String(), `"state":"unlinked"`) || !strings.Contains(out.Body.String(), `"paired":false`) {
+			t.Fatal(out)
+		}
+	}
+	fresh, _ := m.Get(sess.id)
+	if fresh == sess || fresh.client.Store.ID != nil || fresh.client.Store.Deleted {
+		t.Fatal("must install fresh usable device")
+	}
+	rows, err := m.store.list(context.Background())
+	if err != nil || len(rows) != 1 || rows[0].JID != "" {
+		t.Fatalf("stale session JID: %+v %v", rows, err)
+	}
+	m.sessions = map[string]*Session{}
+	m.order = nil
+	if err := m.Restore(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(m.infos()) != 0 {
+		t.Fatal("unlinked account restored")
+	}
+}
+func TestAccountUnlinkBusy(t *testing.T) {
+	for _, reason := range []string{"call", "target", "login"} {
+		t.Run(reason, func(t *testing.T) {
+			m := newTestManager(t)
+			s := m.addUnconnected(t, "test")
+			switch reason {
+			case "call":
+				s.reg.add("active", &activeCall{})
+			case "target":
+				s.target = &targetPairing{State: "waiting", ExpiresAt: time.Now().Add(time.Minute)}
+			case "login":
+				s.pairingDone = make(chan struct{})
+			}
+			if out := unlinkRequest(m, s.id, "{}"); out.Code != 409 {
+				t.Fatal(out)
+			}
+			if s.unlinking {
+				t.Fatal("busy session mutated")
+			}
+		})
+	}
+}
+func pairedUnlinkTestSession(t *testing.T, m *SessionManager) *Session {
+	s := m.addUnconnected(t, "paired")
+	jid := types.NewJID("15551234567", types.DefaultUserServer)
+	s.client.Store.ID = &jid
+	s.client.Store.Account = &waAdv.ADVSignedDeviceIdentity{Details: []byte{}, AccountSignature: make([]byte, 64), AccountSignatureKey: make([]byte, 32), DeviceSignature: make([]byte, 64)}
+	if err := s.client.Store.Save(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.store.setJID(context.Background(), s.id, jid.String()); err != nil {
+		t.Fatal(err)
+	}
+	return s
+}
+func TestAccountUnlinkNetworkFailurePreservesCredentialsAndBlocksReuse(t *testing.T) {
+	m := newTestManager(t)
+	s := pairedUnlinkTestSession(t, m)
+	_, err := m.unlinkAccountUsing(context.Background(), s.id, func(context.Context, *whatsmeow.Client) error { return errors.New("network failure") })
+	if !errors.Is(err, errUnlinkRecovery) || s.client.Store.ID == nil {
+		t.Fatal("ambiguous logout erased device")
+	}
+	pending, confirmed, err := m.unlinkState(context.Background(), s.id)
+	if err != nil || !pending || confirmed {
+		t.Fatal("missing recovery journal")
+	}
+	if _, err := s.startOutgoing(context.Background(), types.EmptyJID, false); err == nil {
+		t.Fatal("call allowed during recovery")
+	}
+	req := httptest.NewRequest("POST", "/", nil)
+	req.SetPathValue("sid", s.id)
+	out := httptest.NewRecorder()
+	(&server{sessions: m}).handleConnectionConnect(out, req)
+	if out.Code != 409 {
+		t.Fatal("reconnect allowed during recovery")
+	}
+}
+
+type failingDeleteContainer struct{ store.DeviceContainer }
+
+func (c failingDeleteContainer) DeleteDevice(context.Context, *store.Device) error {
+	return errors.New("local delete failure")
+}
+func TestAccountUnlinkConfirmedCleanupRetryAndIsolation(t *testing.T) {
+	ctx := context.Background()
+	m := newTestManager(t)
+	s := pairedUnlinkTestSession(t, m)
+	other := m.addUnconnected(t, "other")
+	otherJID := types.NewJID("15557654321", types.DefaultUserServer)
+	other.client.Store.ID = &otherJID
+	other.client.Store.Account = &waAdv.ADVSignedDeviceIdentity{Details: []byte{}, AccountSignature: make([]byte, 64), AccountSignatureKey: make([]byte, 32), DeviceSignature: make([]byte, 64)}
+	if err := other.client.Store.Save(ctx); err != nil {
+		t.Fatal(err)
+	}
+	oldJID := *s.client.Store.ID
+	m.broker.upsertCall(CallRecord{SessionID: s.id, CallID: "history", Status: StatusEnded})
+	base := s.client.Store.Container
+	s.client.Store.Container = failingDeleteContainer{base}
+	calls := 0
+	_, err := m.unlinkAccountUsing(ctx, s.id, func(ctx context.Context, c *whatsmeow.Client) error { calls++; return c.Store.Delete(ctx) })
+	if !errors.Is(err, errUnlinkRecovery) {
+		t.Fatal("cleanup error reported success")
+	}
+	pending, confirmed, err := m.unlinkState(ctx, s.id)
+	if err != nil || !pending || !confirmed {
+		t.Fatal("remote acknowledgment lost")
+	}
+	s.client.Store.Container = base
+	fresh, err := m.unlinkAccountUsing(ctx, s.id, func(context.Context, *whatsmeow.Client) error {
+		t.Fatal("remote logout repeated after confirmed ack")
+		return nil
+	})
+	if err != nil || fresh.client.Store.ID != nil || calls != 1 {
+		t.Fatal("cleanup retry failed", err)
+	}
+	if got, ok := m.Get(other.id); !ok || got != other {
+		t.Fatal("unrelated session changed")
+	}
+	if device, err := m.container.GetDevice(ctx, oldJID); err != nil || device != nil {
+		t.Fatal("old device survived", err)
+	}
+	if device, err := m.container.GetDevice(ctx, otherJID); err != nil || device == nil {
+		t.Fatal("unrelated device removed", err)
+	}
+	if record, ok := m.broker.getCall("history"); !ok || record == nil {
+		t.Fatal("history lost")
+	}
+	rows, _ := m.store.list(ctx)
+	for _, r := range rows {
+		if r.ID == s.id && r.JID != "" {
+			t.Fatal("old JID persisted")
+		}
+	}
+}
+func TestAccountUnlinkRestoreRecoveryDoesNotConnect(t *testing.T) {
+	ctx := context.Background()
+	m := newTestManager(t)
+	s := pairedUnlinkTestSession(t, m)
+	if _, err := m.store.db.ExecContext(ctx, `INSERT INTO account_unlinks(session_id,remote_confirmed) VALUES (?,1)`, s.id); err != nil {
+		t.Fatal(err)
+	}
+	m.sessions = map[string]*Session{}
+	m.order = nil
+	if err := m.Restore(ctx); err != nil {
+		t.Fatal(err)
+	}
+	restored, ok := m.Get(s.id)
+	if !ok || !restored.unlinking || restored.auth.State != "unlink_recovery_required" || restored.client.IsConnected() {
+		t.Fatal("unsafe restore")
+	}
+	fresh, err := m.unlinkAccountUsing(ctx, s.id, func(context.Context, *whatsmeow.Client) error {
+		t.Fatal("confirmed unlink contacted network")
+		return nil
+	})
+	if err != nil || fresh.client.Store.ID != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAccountUnlinkFinalStoreFailureKeepsVisibleRecovery(t *testing.T) {
+	ctx := context.Background()
+	m := newTestManager(t)
+	s := pairedUnlinkTestSession(t, m)
+	_, err := m.store.db.ExecContext(ctx, `CREATE TRIGGER fail_unlink_clear BEFORE DELETE ON account_unlinks BEGIN SELECT RAISE(FAIL, 'test failure'); END`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = m.unlinkAccountUsing(ctx, s.id, func(ctx context.Context, c *whatsmeow.Client) error { return c.Store.Delete(ctx) })
+	if !errors.Is(err, errUnlinkRecovery) || s.client.Store.ID != nil {
+		t.Fatal("expected confirmed remote unlink and failed final cleanup")
+	}
+	out := httptest.NewRecorder()
+	(&server{sessions: m}).connectionStatus(out, s)
+	if !strings.Contains(out.Body.String(), `"state":"unlink_recovery_required"`) || !strings.Contains(out.Body.String(), `"paired":false`) {
+		t.Fatal(out.Body.String())
+	}
+	m.sessions = map[string]*Session{}
+	m.order = nil
+	if err := m.Restore(ctx); err != nil {
+		t.Fatal(err)
+	}
+	restored, _ := m.Get(s.id)
+	out = httptest.NewRecorder()
+	(&server{sessions: m}).connectionStatus(out, restored)
+	if !strings.Contains(out.Body.String(), `"state":"unlink_recovery_required"`) {
+		t.Fatal(out.Body.String())
+	}
+	if _, err := m.store.db.ExecContext(ctx, `DROP TRIGGER fail_unlink_clear`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.unlinkAccountUsing(ctx, s.id, func(context.Context, *whatsmeow.Client) error { t.Fatal("must only finish local cleanup"); return nil }); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestAccountUnlinkJoinsCompletedPairingAndReservesCallAdmission(t *testing.T) {
+	ctx := context.Background()
+	m := newTestManager(t)
+	s := pairedUnlinkTestSession(t, m)
+	pairingCtx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	s.pairingCancel = cancel
+	s.pairingDone = done
+	s.pairingCompleted = true
+	go func() { <-pairingCtx.Done(); _ = m.store.setJID(ctx, s.id, s.client.Store.ID.String()); close(done) }()
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	result := make(chan error, 1)
+	go func() {
+		_, err := m.unlinkAccountUsing(ctx, s.id, func(ctx context.Context, c *whatsmeow.Client) error {
+			close(entered)
+			<-release
+			return c.Store.Delete(ctx)
+		})
+		result <- err
+	}()
+	<-entered
+	select {
+	case <-done:
+	default:
+		t.Fatal("QR worker not drained")
+	}
+	if _, err := s.startOutgoing(ctx, types.EmptyJID, false); err == nil {
+		t.Fatal("call raced unlink")
+	}
+	close(release)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	rows, err := m.store.list(ctx)
+	if err != nil || len(rows) != 1 || rows[0].JID != "" {
+		t.Fatal("late QR worker revived old JID")
+	}
+}
