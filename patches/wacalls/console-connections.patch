+package main
+
+import (
+	"go.mau.fi/whatsmeow/types"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestConnectionManagementPreservesSession(t *testing.T) {
+	mgr := newTestManager(t)
+	sess := mgr.addUnconnected(t, "test")
+	jid := types.NewJID("12345", types.DefaultUserServer)
+	sess.client.Store.ID = &jid
+	sess.setAuth(AuthSnapshot{State: "open", Paired: true})
+	srv := &server{sessions: mgr}
+	for _, operation := range []string{"status", "connect", "disconnect"} {
+		req := httptest.NewRequest("POST", "/", nil)
+		req.SetPathValue("sid", sess.id)
+		response := httptest.NewRecorder()
+		switch operation {
+		case "status":
+			srv.handleConnectionStatus(response, req)
+		case "connect":
+			srv.handleConnectionConnect(response, req)
+		case "disconnect":
+			srv.handleConnectionDisconnect(response, req)
+		}
+		if response.Code != 200 {
+			t.Fatalf("%s: %d", operation, response.Code)
+		}
+		if sess.client.Store.ID == nil || *sess.client.Store.ID != jid {
+			t.Fatal("operator operation destroyed paired device")
+		}
+		if response.Header().Get("Cache-Control") != "no-store" {
+			t.Fatal("sensitive response must not be cached")
+		}
+	}
+	if sess.auth.State != "disconnected" {
+		t.Fatal("disconnect state not set")
+	}
+}
+func TestConnectionStatusDoesNotCreateSession(t *testing.T) {
+	srv := &server{sessions: newTestManager(t)}
+	req := httptest.NewRequest("GET", "/", nil)
+	req.SetPathValue("sid", "missing")
+	response := httptest.NewRecorder()
+	srv.handleConnectionStatus(response, req)
+	if len(srv.sessions.infos()) != 0 {
+		t.Fatal("read created a session")
+	}
+}
