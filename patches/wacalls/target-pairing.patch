diff --git a/cmd/server/targetpairing.go b/cmd/server/targetpairing.go
new file mode 100644
index 0000000..6c7a0a3
--- /dev/null
+++ b/cmd/server/targetpairing.go
@@ -0,0 +1,275 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"time"
+
+	"github.com/google/uuid"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/reflect/protoreflect"
+)
+
+type targetCandidate struct {
+	ID    string `json:"id"`
+	Phone string `json:"phone"`
+}
+type targetPairing struct {
+	ID        string           `json:"id"`
+	Method    string           `json:"method"`
+	State     string           `json:"state"`
+	ExpiresAt time.Time        `json:"expires_at"`
+	Candidate *targetCandidate `json:"candidate,omitempty"`
+	code      string
+	armedAt   time.Time
+}
+
+var targetCode = regexp.MustCompile(`^VOX-[A-F0-9]{12}$`)
+
+func canonicalUUID(value string) bool {
+	parsed, err := uuid.Parse(value)
+	return err == nil && parsed.String() == value
+}
+func (s *Session) expireTargetLocked(now time.Time) {
+	if p := s.target; p != nil && (p.State == "waiting" || p.State == "candidate") && !now.Before(p.ExpiresAt) {
+		p.State = "expired"
+		p.code = ""
+		p.Candidate = nil
+	}
+}
+func (s *Session) cancelTarget() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.target != nil {
+		s.target.State = "cancelled"
+		s.target.code = ""
+		s.target.Candidate = nil
+	}
+}
+func targetPhone(ctx context.Context, jid types.JID, lookup storedLIDLookup) string {
+	if jid.Server == types.HiddenUserServer {
+		mapped := storedPeerPhone(ctx, jid.String(), lookup)
+		var err error
+		jid, err = types.ParseJID(mapped)
+		if err != nil {
+			return ""
+		}
+	}
+	if jid.Server != types.DefaultUserServer || !phoneUser.MatchString(jid.User) {
+		return ""
+	}
+	return "+" + jid.User
+}
+func (s *Session) observeTargetLocked(ctx context.Context, jid types.JID, timestamp time.Time) {
+	p := s.target
+	if p == nil || p.State != "waiting" || timestamp.Before(p.armedAt.Truncate(time.Second)) || timestamp.After(time.Now().Add(5*time.Second)) {
+		return
+	}
+	phone := targetPhone(ctx, jid, s.client.Store.LIDs)
+	own := ""
+	if s.client.Store.ID != nil {
+		own = targetPhone(ctx, *s.client.Store.ID, s.client.Store.LIDs)
+	}
+	if phone == "" || phone == own {
+		return
+	}
+	p.Candidate = &targetCandidate{ID: uuid.NewString(), Phone: phone}
+	p.State = "candidate"
+	p.code = ""
+}
+
+// Accept a single plain text payload and explicitly allowlisted transport metadata.
+func plainTargetText(evt *events.Message) string {
+	if evt == nil || evt.Message == nil || evt.SourceWebMsg != nil || evt.UnavailableRequestID != "" || evt.RetryCount != 0 || evt.NewsletterMeta != nil || evt.IsEphemeral || evt.IsViewOnce || evt.IsViewOnceV2 || evt.IsViewOnceV2Extension || evt.IsDocumentWithCaption || evt.IsLottieSticker || evt.IsBotInvoke || evt.IsEdit {
+		return ""
+	}
+	i := evt.Info
+	if i.IsFromMe || i.IsGroup || i.Multicast || i.Edit != "" || i.DeviceSentMeta != nil || i.Category != "" || i.MsgBotInfo.EditType != "" || i.MsgBotInfo.EditTargetID != "" || !i.MsgBotInfo.EditSenderTimestampMS.IsZero() || i.MsgMetaInfo.TargetID != "" || !i.MsgMetaInfo.TargetSender.IsEmpty() || !i.MsgMetaInfo.TargetChat.IsEmpty() || !i.BroadcastListOwner.IsEmpty() || len(i.BroadcastRecipients) > 0 {
+		return ""
+	}
+	if i.Chat.Server != types.DefaultUserServer && i.Chat.Server != types.HiddenUserServer {
+		return ""
+	}
+	if i.Chat.ToNonAD() != i.Sender.ToNonAD() {
+		return ""
+	}
+	text := targetPayloadText(evt.Message.ProtoReflect())
+	if evt.RawMessage != nil && targetPayloadText(evt.RawMessage.ProtoReflect()) != text {
+		return ""
+	}
+	return text
+}
+func onlyFields(m protoreflect.Message, allowed ...string) bool {
+	if len(m.GetUnknown()) != 0 {
+		return false
+	}
+	valid := true
+	m.Range(func(f protoreflect.FieldDescriptor, v protoreflect.Value) bool {
+		found := false
+		for _, name := range allowed {
+			if string(f.Name()) == name {
+				found = true
+				break
+			}
+		}
+		if !found {
+			valid = false
+		}
+		return valid
+	})
+	return valid
+}
+func targetPayloadText(m protoreflect.Message) string {
+	if !onlyFields(m, "conversation", "extendedTextMessage", "messageContextInfo") {
+		return ""
+	}
+	text := ""
+	payloads := 0
+	valid := true
+	m.Range(func(f protoreflect.FieldDescriptor, v protoreflect.Value) bool {
+		switch string(f.Name()) {
+		case "conversation":
+			payloads++
+			text = v.String()
+		case "extendedTextMessage":
+			payloads++
+			ext := v.Message()
+			if !onlyFields(ext, "text", "contextInfo") {
+				valid = false
+				break
+			}
+			text = ext.Get(ext.Descriptor().Fields().ByName("text")).String()
+			contextField := ext.Descriptor().Fields().ByName("contextInfo")
+			if ext.Has(contextField) && !onlyFields(ext.Get(contextField).Message(), "expiration", "ephemeralSettingTimestamp", "ephemeralSharedSecret") {
+				valid = false
+			}
+		case "messageContextInfo":
+			info := v.Message()
+			if !onlyFields(info, "deviceListMetadata", "deviceListMetadataVersion", "messageSecret", "paddingBytes", "reportingTokenVersion") {
+				valid = false
+				break
+			}
+			devices := info.Descriptor().Fields().ByName("deviceListMetadata")
+			if info.Has(devices) && !onlyFields(info.Get(devices).Message(), "senderKeyHash", "senderTimestamp", "senderKeyIndexes", "senderAccountType", "receiverAccountType", "recipientKeyHash", "recipientTimestamp", "recipientKeyIndexes") {
+				valid = false
+			}
+		}
+		return valid
+	})
+	if !valid || payloads != 1 {
+		return ""
+	}
+	return text
+}
+func (s *Session) observeTargetMessage(evt *events.Message) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.expireTargetLocked(time.Now())
+	if s.target == nil || s.target.State != "waiting" || s.target.Method != "message" {
+		return
+	}
+	if text := plainTargetText(evt); text != "" && text == s.target.code {
+		s.observeTargetLocked(context.Background(), evt.Info.Sender, evt.Info.Timestamp)
+	}
+}
+func (s *Session) consumeTargetCall(ctx context.Context, evt *events.CallOffer) bool {
+	s.expireTargetLocked(time.Now())
+	p := s.target
+	if p == nil || (p.State != "waiting" && p.State != "candidate") {
+		return false
+	}
+	if p.Method == "call" && evt.GroupJID.IsEmpty() {
+		s.observeTargetLocked(ctx, evt.From, evt.Timestamp)
+	}
+	// Reject before creating a call manager, ledger entry, or event stream record.
+	bounded, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	s.rejectOffer(bounded, wrapCall(evt.From, evt.Data), evt.From)
+	return true
+}
+func (s *server) handleTargetPairingStart(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	var req struct {
+		ID        string    `json:"id"`
+		Method    string    `json:"method"`
+		Code      string    `json:"code,omitempty"`
+		ExpiresAt time.Time `json:"expires_at"`
+	}
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1024))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&req); err != nil {
+		writeJSON(w, 400, map[string]string{"error": "invalid request"})
+		return
+	}
+	var extra any
+	if dec.Decode(&extra) != io.EOF {
+		writeJSON(w, 400, map[string]string{"error": "invalid request"})
+		return
+	}
+	now := time.Now()
+	if !canonicalUUID(req.ID) || (req.Method != "message" && req.Method != "call") || (req.Method == "message" && !targetCode.MatchString(req.Code)) || (req.Method == "call" && req.Code != "") || !req.ExpiresAt.After(now) || req.ExpiresAt.After(now.Add(3*time.Minute)) {
+		writeJSON(w, 400, map[string]string{"error": "invalid request"})
+		return
+	}
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	sess, ok := s.sessions.Get(r.PathValue("sid"))
+	if !ok {
+		writeJSON(w, 404, map[string]string{"error": "session not found"})
+		return
+	}
+	sess.mu.Lock()
+	defer sess.mu.Unlock()
+	sess.expireTargetLocked(now)
+	if sess.client.Store.ID == nil || !sess.client.IsConnected() || !sess.client.IsLoggedIn() || sess.reg.count() != 0 || (sess.target != nil && (sess.target.State == "waiting" || sess.target.State == "candidate")) {
+		writeJSON(w, 409, map[string]string{"error": "session unavailable"})
+		return
+	}
+	sess.target = &targetPairing{ID: req.ID, Method: req.Method, State: "waiting", ExpiresAt: req.ExpiresAt, code: req.Code, armedAt: now}
+	writeJSON(w, 201, sess.target)
+}
+func (s *server) handleTargetPairingGet(w http.ResponseWriter, r *http.Request) {
+	s.targetPairingResult(w, r, false)
+}
+func (s *server) handleTargetPairingCancel(w http.ResponseWriter, r *http.Request) {
+	s.targetPairingResult(w, r, true)
+}
+func (s *server) targetPairingResult(w http.ResponseWriter, r *http.Request, cancel bool) {
+	w.Header().Set("Cache-Control", "no-store")
+	if cancel {
+		dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16))
+		dec.DisallowUnknownFields()
+		var body struct{}
+		if err := dec.Decode(&body); err != nil && err != io.EOF {
+			writeJSON(w, 400, map[string]string{"error": "invalid request"})
+			return
+		}
+		var extra any
+		if dec.Decode(&extra) != io.EOF {
+			writeJSON(w, 400, map[string]string{"error": "invalid request"})
+			return
+		}
+	}
+	sess, ok := s.sessions.Get(r.PathValue("sid"))
+	if !ok {
+		writeJSON(w, 404, map[string]string{"error": "pairing not found"})
+		return
+	}
+	sess.mu.Lock()
+	defer sess.mu.Unlock()
+	sess.expireTargetLocked(time.Now())
+	if !canonicalUUID(r.PathValue("id")) || sess.target == nil || sess.target.ID != r.PathValue("id") {
+		writeJSON(w, 404, map[string]string{"error": "pairing not found"})
+		return
+	}
+	if cancel {
+		sess.target.State = "cancelled"
+		sess.target.code = ""
+		sess.target.Candidate = nil
+	}
+	writeJSON(w, 200, sess.target)
+}
