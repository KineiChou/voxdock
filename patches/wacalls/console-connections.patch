+package main
+
+import (
+	"go.mau.fi/whatsmeow"
+	"net/http"
+	"regexp"
+	"sync"
+)
+
+// Serialize operator changes; pairing is asynchronous and status reads never reset it.
+var connectionMu sync.Mutex
+var connectionID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,100}$`)
+
+func (s *server) connectionStatus(w http.ResponseWriter, sess *Session) {
+	w.Header().Set("Cache-Control", "no-store")
+	if sess == nil {
+		writeJSON(w, http.StatusOK, map[string]any{"paired": false, "state": "missing"})
+		return
+	}
+	sess.mu.Lock()
+	a := sess.auth
+	sess.mu.Unlock()
+	writeJSON(w, http.StatusOK, map[string]any{"paired": sess.client.Store.ID != nil, "state": a.State, "qr": a.QR})
+}
+func (s *server) handleConnectionStatus(w http.ResponseWriter, r *http.Request) {
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	sess, _ := s.sessions.Get(r.PathValue("sid"))
+	s.connectionStatus(w, sess)
+}
+func (s *server) handleConnectionConnect(w http.ResponseWriter, r *http.Request) {
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	id := r.PathValue("sid")
+	if !connectionID.MatchString(id) {
+		writeJSON(w, 400, map[string]string{"error": "invalid session"})
+		return
+	}
+	sess, exists := s.sessions.Get(id)
+	if !exists {
+		if err := s.sessions.store.insert(s.sessions.appCtx, id, "VoxDock"); err != nil {
+			writeJSON(w, 409, map[string]string{"error": "session unavailable"})
+			return
+		}
+		sess = newSession(s.sessions, id, "VoxDock", whatsmeow.NewClient(s.sessions.container.NewDevice(), s.sessions.waLogger))
+		sess.setAuth(AuthSnapshot{State: "disconnected"})
+		s.sessions.register(sess)
+	}
+	if sess.reg.count() != 0 {
+		writeJSON(w, 409, map[string]string{"error": "session has active calls"})
+		return
+	}
+	sess.mu.Lock()
+	state := sess.auth.State
+	sess.mu.Unlock()
+	if state != "open" && state != "qr" && state != "connecting" {
+		sess.setAuth(AuthSnapshot{State: "connecting", Paired: sess.client.Store.ID != nil})
+		if err := sess.connect(s.sessions.appCtx); err != nil {
+			sess.setAuth(AuthSnapshot{State: "unknown"})
+			writeJSON(w, 502, map[string]string{"error": "connection unconfirmed"})
+			return
+		}
+	}
+	s.connectionStatus(w, sess)
+}
+func (s *server) handleConnectionDisconnect(w http.ResponseWriter, r *http.Request) {
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	sess, _ := s.sessions.Get(r.PathValue("sid"))
+	if sess != nil {
+		if sess.reg.count() != 0 {
+			writeJSON(w, 409, map[string]string{"error": "session has active calls"})
+			return
+		}
+		sess.mu.Lock()
+		if sess.pairingCancel != nil {
+			sess.pairingCancel()
+			sess.pairingCancel = nil
+		}
+		sess.mu.Unlock()
+		sess.client.Disconnect()
+		sess.setAuth(AuthSnapshot{State: "disconnected", Paired: sess.client.Store.ID != nil})
+	}
+	s.connectionStatus(w, sess)
+}
