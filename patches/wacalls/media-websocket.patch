@@ -0,0 +1,32 @@
+package main
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"wacalls/internal/voip/call"
+)
+
+func TestEndHTTPNeverForcesUnconfirmedCallEnded(t *testing.T) {
+	sess := &Session{reg: newCallRegistry()}
+	// An active registry entry without terminal evidence must not produce an ended response.
+	sess.reg.add("c", &activeCall{cm: call.NewCallManager(nil, nil)})
+	s := &server{broker: NewBroker()}
+	request := httptest.NewRequest("DELETE", "/", nil)
+	request.SetPathValue("id", "c")
+	out := httptest.NewRecorder()
+	s.doEndCall(sess, out, request)
+	if out.Code != 502 || !strings.Contains(out.Body.String(), "hangup_unconfirmed") {
+		t.Fatalf("dishonest response: %d", out.Code)
+	}
+	if _, ok := sess.reg.get("c"); !ok {
+		t.Fatal("unconfirmed reservation removed")
+	}
+	request.SetPathValue("id", "missing")
+	out = httptest.NewRecorder()
+	s.doEndCall(sess, out, request)
+	if out.Code != 404 {
+		t.Fatal("missing call invented terminal confirmation")
+	}
+}
