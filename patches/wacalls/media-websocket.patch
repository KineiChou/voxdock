new file mode 100644
index 0000000..b41fdeb
--- /dev/null
+++ b/internal/voip/call/termination_test.go
@@ -0,0 +1,131 @@
+package call
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+	"wacalls/internal/voip/core"
+	"wacalls/internal/voip/signaling"
+)
+
+type terminationSocket struct {
+	core.VoipSocket
+	query func(context.Context, waBinary.Node) (*waBinary.Node, error)
+}
+
+func (s *terminationSocket) Query(ctx context.Context, n waBinary.Node) (*waBinary.Node, error) {
+	return s.query(ctx, n)
+}
+func terminationManager(query func(context.Context, waBinary.Node) (*waBinary.Node, error)) *CallManager {
+	m := NewCallManager(&terminationSocket{query: query}, nil)
+	m.currentCall = NewOutgoingCall("call-1", "2@s.whatsapp.net", "1@s.whatsapp.net", core.CallMediaTypeAudio)
+	return m
+}
+func ackFor(n waBinary.Node) *waBinary.Node {
+	return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"id": n.Attrs["id"], "class": "call"}}
+}
+
+func TestEndCallRequiresAcknowledgmentBeforeEnded(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	queries := 0
+	m := terminationManager(func(ctx context.Context, n waBinary.Node) (*waBinary.Node, error) {
+		queries++
+		if _, ok := ctx.Deadline(); !ok {
+			t.Error("missing bounded query context")
+		}
+		close(started)
+		<-release
+		return ackFor(n), nil
+	})
+	ended := 0
+	m.OnEnded = func(*CallInfo) { ended++ }
+	done := make(chan error, 1)
+	go func() { done <- m.EndCall(context.Background(), core.EndCallReasonUserEnded) }()
+	<-started
+	if m.CurrentCall().IsEnded() {
+		t.Fatal("ended advertised before acknowledgment")
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if !m.CurrentCall().IsEnded() || m.TerminationEvidence() != "acknowledged" || ended != 1 {
+		t.Fatal("missing acknowledged completion")
+	}
+	if err := m.EndCall(context.Background(), core.EndCallReasonUserEnded); err != nil {
+		t.Fatal(err)
+	}
+	if queries != 1 || ended != 1 {
+		t.Fatal("repeat end sent another query or event")
+	}
+}
+
+func TestEndCallUnknownOutcomesRetainCall(t *testing.T) {
+	cases := map[string]func(context.Context, waBinary.Node) (*waBinary.Node, error){
+		"nil-timeout": func(context.Context, waBinary.Node) (*waBinary.Node, error) { return nil, nil },
+		"transport-error": func(context.Context, waBinary.Node) (*waBinary.Node, error) {
+			return nil, errors.New("private transport detail")
+		},
+		"wrong-id": func(context.Context, waBinary.Node) (*waBinary.Node, error) {
+			return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "id": "other"}}, nil
+		},
+		"error-ack": func(_ context.Context, n waBinary.Node) (*waBinary.Node, error) {
+			a := ackFor(n)
+			a.Attrs["error"] = "500"
+			return a, nil
+		},
+		"cancelled": func(ctx context.Context, _ waBinary.Node) (*waBinary.Node, error) {
+			<-ctx.Done()
+			return nil, ctx.Err()
+		},
+	}
+	for name, query := range cases {
+		t.Run(name, func(t *testing.T) {
+			count := 0
+			m := terminationManager(func(ctx context.Context, n waBinary.Node) (*waBinary.Node, error) { count++; return query(ctx, n) })
+			emitted := false
+			m.OnEnded = func(*CallInfo) { emitted = true }
+			ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+			defer cancel()
+			if err := m.EndCall(ctx, core.EndCallReasonUserEnded); err == nil {
+				t.Fatal("unknown outcome reported success")
+			}
+			if m.CurrentCall().IsEnded() || emitted || m.TerminationEvidence() != "unconfirmed" {
+				t.Fatal("unknown outcome freed call")
+			}
+			if err := m.EndCall(context.Background(), core.EndCallReasonUserEnded); err == nil || count != 1 {
+				t.Fatal("unknown outcome retried blindly")
+			}
+		})
+	}
+}
+
+func TestPeerTerminationWhileEndQueryPending(t *testing.T) {
+	var m *CallManager
+	m = terminationManager(func(context.Context, waBinary.Node) (*waBinary.Node, error) {
+		n := signaling.BuildTerminateStanza(types.NewJID("1", types.DefaultUserServer), "call-1", types.NewJID("1", types.DefaultUserServer))
+		m.HandleCallTerminate(&n)
+		return nil, nil
+	})
+	if err := m.EndCall(context.Background(), core.EndCallReasonUserEnded); err != nil {
+		t.Fatal(err)
+	}
+	if !m.CurrentCall().IsEnded() || m.TerminationEvidence() != "remote" {
+		t.Fatal("peer evidence lost")
+	}
+}
+
+func TestUnconfirmedTerminationIgnoresLateRelayConnected(t *testing.T) {
+	m := terminationManager(func(context.Context, waBinary.Node) (*waBinary.Node, error) { return nil, nil })
+	m.currentCall.StateData.State = core.CallStateConnecting
+	_ = m.EndCall(context.Background(), core.EndCallReasonUserEnded)
+	m.onRelayConnected()
+	if m.CurrentCall().StateData.State != core.CallStateConnecting || m.keepaliveStop != nil {
+		t.Fatal("late relay restarted terminated media")
+	}
+}
