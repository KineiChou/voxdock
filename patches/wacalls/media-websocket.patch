@@ -0,0 +1,34 @@
+package main
+
+import (
+	"context"
+	"regexp"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+type storedLIDLookup interface {
+	GetPNForLID(context.Context, types.JID) (types.JID, error)
+}
+
+var phoneUser = regexp.MustCompile(`^[1-9][0-9]{4,14}$`)
+
+// Only the authenticated account's existing mapping is authoritative here.
+// This does not perform network discovery or infer a phone number from LID digits.
+func storedPeerPhone(ctx context.Context, peer string, lookup storedLIDLookup) string {
+	jid, err := types.ParseJID(peer)
+	if err != nil || jid.Server != types.HiddenUserServer || lookup == nil {
+		return ""
+	}
+	bounded, cancel := context.WithTimeout(ctx, time.Second)
+	defer cancel()
+	if bounded.Err() != nil {
+		return ""
+	}
+	pn, err := lookup.GetPNForLID(bounded, jid.ToNonAD())
+	if err != nil || bounded.Err() != nil || pn.Server != types.DefaultUserServer || !phoneUser.MatchString(pn.User) {
+		return ""
+	}
+	return pn.ToNonAD().String()
+}
