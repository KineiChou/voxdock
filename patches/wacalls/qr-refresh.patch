diff --git a/cmd/server/qrrefresh.go b/cmd/server/qrrefresh.go
new file mode 100644
index 0000000..62052a8
--- /dev/null
+++ b/cmd/server/qrrefresh.go
@@ -0,0 +1,222 @@
+package main
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// Protected by Session.mu. Admission precedes whatsmeow's detached credential writer.
+type pairingAttempt struct {
+	client  *whatsmeow.Client
+	retired bool
+	writing bool
+	paired  bool
+	cleanup bool
+}
+
+func (s *Session) installClient(client *whatsmeow.Client) {
+	a := &pairingAttempt{client: client, paired: client.Store.ID != nil}
+	s.mu.Lock()
+	s.client, s.attempt = client, a
+	s.mu.Unlock()
+	client.PrePairCallback = func(types.JID, string, string) bool {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		if s.attempt != a || a.retired {
+			return false
+		}
+		a.writing = true
+		s.auth = AuthSnapshot{State: "pairing"}
+		return true
+	}
+	client.AddEventHandler(func(event any) { s.handleAttemptEvent(a, event) })
+}
+
+func (s *Session) handleAttemptEvent(a *pairingAttempt, event any) {
+	s.mu.Lock()
+	if s.attempt != a || a.retired {
+		s.mu.Unlock()
+		return
+	}
+	switch event.(type) {
+	case *events.Connected:
+		a.writing, a.paired = false, true
+	case *events.LoggedOut:
+		a.paired = false
+	case *events.Disconnected:
+		if a.writing {
+			s.mu.Unlock()
+			return
+		}
+	case *events.PairSuccess:
+		a.writing, a.paired = false, true
+		s.pairingCompleted = true
+		s.auth = AuthSnapshot{State: "connecting", Paired: true}
+		s.mu.Unlock()
+		if id := a.client.Store.ID; id != nil {
+			_ = s.mgr.store.setJID(s.mgr.appCtx, s.id, id.String())
+		}
+		return
+	case *events.PairError:
+		a.writing = false
+		// An ID can precede Save or remain after failed cleanup. Never erase ambiguous credentials.
+		a.cleanup = a.client.Store.ID != nil
+		s.mu.Unlock()
+		s.failAttempt(a, "pairing_failed", "whatsapp_pairing_failed")
+		return
+	}
+	s.mu.Unlock()
+	s.handleEvent(event)
+}
+
+func (s *Session) publishAttempt(a *pairingAttempt, auth AuthSnapshot) {
+	s.mu.Lock()
+	if s.attempt != a || a.retired || a.writing || a.paired {
+		s.mu.Unlock()
+		return
+	}
+	s.auth = auth
+	s.mu.Unlock()
+	s.mgr.broker.emitAuthState(s.id, auth)
+}
+
+func (s *Session) failAttempt(a *pairingAttempt, state, code string) {
+	s.mu.Lock()
+	if s.attempt != a || a.retired || a.writing || a.paired {
+		s.mu.Unlock()
+		return
+	}
+	if a.cleanup {
+		state, code = "pairing_recovery_required", "connection_cleanup_required"
+	}
+	s.auth = AuthSnapshot{State: state, Error: code}
+	a.retired = true
+	cancel := s.pairingCancel
+	auth := s.auth
+	s.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	s.log.Warn("WhatsApp pairing ended", "category", code)
+	s.mgr.broker.emitAuthState(s.id, auth)
+}
+
+func (s *Session) startPairing(ctx context.Context) error {
+	ctx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	s.mu.Lock()
+	a := s.attempt
+	s.pairingCancel, s.pairingDone, s.pairingCompleted = cancel, done, false
+	s.mu.Unlock()
+	go func() {
+		defer func() {
+			s.mu.Lock()
+			if s.attempt == a && s.pairingDone == done && !a.writing {
+				s.pairingDone = nil
+			}
+			s.mu.Unlock()
+			close(done)
+		}()
+		qr, err := a.client.GetQRChannel(ctx)
+		if err != nil {
+			s.failAttempt(a, "pairing_failed", "whatsapp_pairing_failed")
+			return
+		}
+		if err := a.client.ConnectContext(ctx); err != nil {
+			s.failAttempt(a, "pairing_failed", "whatsapp_pairing_failed")
+			return
+		}
+		for {
+			select {
+			case <-ctx.Done():
+				s.failAttempt(a, "pairing_failed", "whatsapp_pairing_interrupted")
+				return
+			case evt, ok := <-qr:
+				if !ok {
+					s.failAttempt(a, "pairing_failed", "whatsapp_pairing_interrupted")
+					return
+				}
+				switch evt.Event {
+				case "code":
+					s.publishAttempt(a, AuthSnapshot{State: "qr", QR: evt.Code, QRExpiresAt: time.Now().Add(evt.Timeout)})
+				case "success":
+					return // PairSuccess persists identity; Connected alone establishes online readiness.
+				case "timeout":
+					s.failAttempt(a, "qr_expired", "whatsapp_pairing_interrupted")
+					return
+				case "err-client-outdated":
+					s.failAttempt(a, "client_outdated", "whatsapp_client_outdated")
+					return
+				case "error":
+					s.failAttempt(a, "pairing_failed", "whatsapp_pairing_failed")
+					return
+				case "err-unexpected-state", "err-scanned-without-multidevice":
+					s.failAttempt(a, "pairing_failed", "whatsapp_pairing_interrupted")
+					return
+				}
+			}
+		}
+	}()
+	return nil
+}
+
+// Called under connectionMu. Returning false preserves a successful/in-flight account.
+func (s *Session) retireUnpaired() bool {
+	s.mu.Lock()
+	a := s.attempt
+	if a.writing || a.paired || a.cleanup || a.client.Store.ID != nil {
+		s.mu.Unlock()
+		return false
+	}
+	a.retired = true
+	cancel, done := s.pairingCancel, s.pairingDone
+	s.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	a.client.Disconnect()
+	if done != nil {
+		<-done
+	}
+	// Join dispatch callbacks before replacing s.client. Detached pairing cannot pass the retired gate.
+	a.client.RemoveEventHandlers()
+	s.mu.Lock()
+	s.pairingCancel, s.pairingDone = nil, nil
+	s.mu.Unlock()
+	return true
+}
+
+func (s *Session) freshPairing() error {
+	if !s.retireUnpaired() {
+		return nil
+	}
+	s.installClient(whatsmeow.NewClient(s.mgr.container.NewDevice(), s.mgr.waLogger))
+	s.setAuth(AuthSnapshot{State: "connecting"})
+	return s.startPairing(s.mgr.appCtx)
+}
+
+func (s *server) handleConnectionRefresh(w http.ResponseWriter, r *http.Request) {
+	connectionMu.Lock()
+	defer connectionMu.Unlock()
+	id := r.PathValue("sid")
+	if !connectionID.MatchString(id) {
+		writeJSON(w, 400, map[string]string{"error": "invalid session"})
+		return
+	}
+	sess, exists := s.sessions.Get(id)
+	if !exists {
+		writeJSON(w, 404, map[string]string{"error": "session not found"})
+		return
+	}
+	if sess.unlinking || sess.reg.count() != 0 {
+		writeJSON(w, 409, map[string]string{"error": "session unavailable"})
+		return
+	}
+	_ = sess.freshPairing()
+	s.connectionStatus(w, sess)
+}
diff --git a/cmd/server/qrrefresh_test.go b/cmd/server/qrrefresh_test.go
new file mode 100644
index 0000000..9823c5f
--- /dev/null
+++ b/cmd/server/qrrefresh_test.go
@@ -0,0 +1,127 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func TestQRRefreshRetiresSourceAndRejectsLateEvents(t *testing.T) {
+	m := newTestManager(t)
+	s := m.addUnconnected(t, "qr")
+	old := s.attempt
+	s.setAuth(AuthSnapshot{State: "qr", QR: "old", QRExpiresAt: time.Now().Add(time.Minute)})
+	if !s.retireUnpaired() {
+		t.Fatal("unpaired source not retired")
+	}
+	s.installClient(whatsmeow.NewClient(m.container.NewDevice(), m.waLogger))
+	s.setAuth(AuthSnapshot{State: "connecting"})
+	if old.client == s.client || old.client.Store.NoiseKey == s.client.Store.NoiseKey {
+		t.Fatal("fresh pairing reused source")
+	}
+	if old.client.PrePairCallback(types.EmptyJID, "", "") {
+		t.Fatal("retired source admitted detached pairing")
+	}
+	s.publishAttempt(old, AuthSnapshot{State: "qr", QR: "late"})
+	s.handleAttemptEvent(old, &events.PairSuccess{})
+	s.handleAttemptEvent(old, &events.Disconnected{})
+	if s.auth.State != "connecting" || s.auth.QR != "" || s.attempt.paired {
+		t.Fatal("stale event changed replacement")
+	}
+}
+
+func TestQRRefreshPairingGateAndSuccessPreserveClient(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		m := newTestManager(t)
+		s := m.addUnconnected(t, "qr")
+		a := s.attempt
+		var admitted, retired bool
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() { defer wg.Done(); admitted = a.client.PrePairCallback(types.EmptyJID, "", "") }()
+		go func() { defer wg.Done(); retired = s.retireUnpaired() }()
+		wg.Wait()
+		if admitted == retired {
+			t.Fatalf("gate outcomes admitted=%v retired=%v", admitted, retired)
+		}
+		if admitted {
+			req := httptest.NewRequest("POST", "/", nil)
+			req.SetPathValue("sid", s.id)
+			out := httptest.NewRecorder()
+			(&server{sessions: m}).handleConnectionRefresh(out, req)
+			var v map[string]any
+			_ = json.Unmarshal(out.Body.Bytes(), &v)
+			if out.Code != 200 || v["state"] != "pairing" || v["qr"] != "" || s.client != a.client {
+				t.Fatal("refresh interrupted pairing")
+			}
+			s.handleAttemptEvent(a, &events.PairSuccess{})
+			if s.retireUnpaired() || s.client != a.client || s.auth.State == "open" {
+				t.Fatal("paired client discarded or prematurely online")
+			}
+		}
+	}
+}
+
+func TestQRRefreshFailureAndExpiry(t *testing.T) {
+	m := newTestManager(t)
+	s := m.addUnconnected(t, "qr")
+	for _, tc := range []struct{ state, code string }{{"pairing_failed", "whatsapp_pairing_failed"}, {"client_outdated", "whatsapp_client_outdated"}, {"qr_expired", "whatsapp_pairing_interrupted"}} {
+		s.installClient(whatsmeow.NewClient(m.container.NewDevice(), m.waLogger))
+		s.publishAttempt(s.attempt, AuthSnapshot{State: "qr", QR: "old"})
+		s.failAttempt(s.attempt, tc.state, tc.code)
+		if s.auth.State != tc.state || s.auth.QR != "" || s.auth.Error != tc.code {
+			t.Fatal("terminal state retained QR")
+		}
+	}
+	s.setAuth(AuthSnapshot{State: "qr", QR: "expired", QRExpiresAt: time.Now().Add(-time.Second)})
+	out := httptest.NewRecorder()
+	(&server{sessions: m}).connectionStatus(out, s)
+	var v map[string]any
+	_ = json.Unmarshal(out.Body.Bytes(), &v)
+	if v["state"] != "connecting" || v["qr"] != "" {
+		t.Fatal("rotation exposed expired QR")
+	}
+}
+
+func TestQRRefreshCancellationTerminatesConsumer(t *testing.T) {
+	m := newTestManager(t)
+	s := m.addUnconnected(t, "qr")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := s.startPairing(ctx); err != nil {
+		t.Fatal(err)
+	}
+	s.mu.Lock()
+	done := s.pairingDone
+	s.mu.Unlock()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancel did not finish pairing")
+	}
+	if s.auth.QR != "" || s.auth.State != "pairing_failed" {
+		t.Fatal("cancel left QR active")
+	}
+}
+
+func TestQRRefreshAmbiguousCredentialsRequireCleanup(t *testing.T) {
+	m := newTestManager(t)
+	s := m.addUnconnected(t, "qr")
+	a := s.attempt
+	if !a.client.PrePairCallback(types.EmptyJID, "", "") {
+		t.Fatal("admission failed")
+	}
+	jid := types.NewJID("12345", types.DefaultUserServer)
+	a.client.Store.ID = &jid
+	s.handleAttemptEvent(a, &events.PairError{})
+	if s.retireUnpaired() || s.auth.Error != "connection_cleanup_required" || s.client != a.client {
+		t.Fatal("ambiguous credentials erased")
+	}
+}
